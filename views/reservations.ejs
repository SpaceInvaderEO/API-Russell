<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('partials/head', { title: 'Réservations' }) %>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="dashboard-layout">
        <%- include('partials/sidebar', { currentPage: 'reservations' }) %>

        <main class="main-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <h2>Gestion des Réservations</h2>
                <button onclick="showModal()" class="btn btn-primary" style="width: auto;">+ Nouvelle Réservation</button>
            </div>

            <div class="table-container">
                <table id="resTable">
                    <thead>
                        <tr>
                            <th>Catway</th>
                            <th>Client</th>
                            <th>Bateau</th>
                            <th>Arrivée</th>
                            <th>Départ</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </main>
    </div>

    <div id="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
        <div class="card" style="max-width: 500px;">
            <h3>Ajouter une Réservation</h3>
            <form id="resForm" style="margin-top: 1.5rem;">
                <div class="form-group">
                    <label>Numéro du Catway</label>
                    <input type="number" id="catwayNumber" required>
                </div>
                <div class="form-group">
                    <label>Nom du Client</label>
                    <input type="text" id="clientName" required>
                </div>
                <div class="form-group">
                    <label>Nom du Bateau</label>
                    <input type="text" id="boatName" required>
                </div>
                <div style="display: flex; gap: 1rem;">
                    <div class="form-group" style="flex: 1;">
                        <label>Début</label>
                        <input type="date" id="startDate" required>
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label>Fin</label>
                        <input type="date" id="endDate" required>
                    </div>
                </div>
                <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                    <button type="button" onclick="hideModal()" class="btn" style="background:#e2e8f0;">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('token');
        const userData = JSON.parse(localStorage.getItem('user'));
        if (!token) window.location.href = '/?error=unauthorized';

        if (userData) {
            document.getElementById('userDisplay').textContent = userData.username;
        }

        document.getElementById('logoutBtn').addEventListener('click', async () => {
            await fetch('/logout');
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            window.location.href = '/';
        });

        async function fetchReservations() {
            const res = await fetch('/reservations', { headers: { 'Authorization': `Bearer ${token}` } });
            if (res.status === 401) window.location.href = '/?error=unauthorized';
            const data = await res.json();
            const tbody = document.querySelector('#resTable tbody');
            tbody.innerHTML = data.map(r => `
                <tr>
                    <td><span class="badge badge-blue">#${r.catwayNumber}</span></td>
                    <td>${r.clientName}</td>
                    <td>${r.boatName}</td>
                    <td>${new Date(r.startDate).toLocaleDateString()}</td>
                    <td>${new Date(r.endDate).toLocaleDateString()}</td>
                    <td>
                        <button onclick="deleteRes('${r.catwayNumber}', '${r._id}')" style="background:none; border:none; color:var(--danger); cursor:pointer; font-weight:600;">Supprimer</button>
                    </td>
                </tr>
            `).join('');
        }

        function showModal() {
            document.getElementById('resForm').reset();
            document.getElementById('modal').style.display = 'flex';
        }

        function hideModal() {
            document.getElementById('modal').style.display = 'none';
        }

        async function deleteRes(catwayId, resId) {
            if (confirm('Supprimer cette réservation ?')) {
                await fetch(`/catways/${catwayId}/reservations/${resId}`, { 
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                fetchReservations();
            }
        }

        document.getElementById('resForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const catwayId = document.getElementById('catwayNumber').value;
            const body = {
                clientName: document.getElementById('clientName').value,
                boatName: document.getElementById('boatName').value,
                startDate: document.getElementById('startDate').value,
                endDate: document.getElementById('endDate').value
            };

            const res = await fetch(`/catways/${catwayId}/reservations`, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify(body)
            });

            if (res.ok) {
                hideModal();
                fetchReservations();
            } else {
                alert('Erreur lors de la création');
            }
        });

        fetchReservations();
    </script>
</body>
</html>
